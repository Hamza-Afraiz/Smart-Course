# SmartCourse backend configuration.
#
# Copy to `.env` and fill in.  Rule of thumb (12-factor):
#   - Anything that CHANGES between dev/staging/prod lives here (env var).
#   - Topology (which services exist, ports, how they wire) lives in
#     docker-compose.yml (dev) or the k8s manifests in deploy/k8s/ (prod).
#
# Lines marked  # CHANGE IN PROD  must NOT keep these dev defaults in
# production — pull them from a secrets manager (Vault / AWS Secrets Manager /
# k8s Secret), never commit real values.
#
# Hostnames below use localhost (host dev). docker-compose overrides them to
# compose service names (postgres, redis, kafka, …) per service.

# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string       # CHANGE IN PROD (JWT signing key)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=smartcourse
POSTGRES_PASSWORD=smartcourse                       # CHANGE IN PROD
POSTGRES_DB=smartcourse
DATABASE_URL=postgresql+psycopg://smartcourse:smartcourse@localhost:5432/smartcourse  # CHANGE IN PROD (managed RDS / Cloud SQL)

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest                             # CHANGE IN PROD
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Temporal (Week 2) ───────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233

# ─── Kafka (Week 3) ──────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# ─── MongoDB (Week 3 — raw event log) ─────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_DB=smartcourse

# ─── Tracing (Week 3 — OpenTelemetry → Jaeger) ─────────────────────────────────
# empty = disabled (host dev). docker-compose sets http://jaeger:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Object storage (Week 4 — MinIO dev / Cloudflare R2 / AWS S3 prod) ─────────
# MINIO_* configure the dev MinIO container; S3_* configure our boto3 client.
# In prod: point S3_*_ENDPOINT at R2/S3, supply real keys, drop the MinIO vars.
MINIO_ROOT_USER=minioadmin                          # CHANGE IN PROD (dev MinIO only)
MINIO_ROOT_PASSWORD=minioadmin                      # CHANGE IN PROD (dev MinIO only)
S3_ACCESS_KEY=minioadmin                            # CHANGE IN PROD
S3_SECRET_KEY=minioadmin                            # CHANGE IN PROD
S3_BUCKET=smartcourse-media
S3_INTERNAL_ENDPOINT=http://minio:9000              # server-side (api/worker)        — CHANGE IN PROD
S3_PUBLIC_ENDPOINT=http://localhost:9000            # browser-facing presigned URLs   — CHANGE IN PROD (CDN / R2 public)

# ─── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin                            # CHANGE IN PROD (prefer SSO)
GRAFANA_ADMIN_PASSWORD=admin                        # CHANGE IN PROD

# ─── LLM / RAG (Week 5 — Ollama local / API in prod) ──────────────────────────
# Local Ollama is free. In prod swap llm_service to an API (OpenAI/Anthropic) — one client change.
OLLAMA_HOST=http://localhost:11434                  # docker-compose: http://ollama:11434
OLLAMA_MODEL=llama3.2:1b                            # 1b is ~3x faster on CPU than 3b for RAG Q&A
RAG_TOP_K=3                                         # chunks per question (was 5 — shorter prompt)
RAG_MIN_SIMILARITY=0.25                             # similarity floor (was 0.15 — tighter filter)
RAG_MAX_CHUNK_TOKENS=200                            # max tokens per retrieved excerpt in the prompt

# ─── SMTP (Tier 2 — Mailhog dev / real provider prod) ────────────────────────
SMTP_ENABLED=true
SMTP_HOST=localhost                                 # docker-compose: mailhog
SMTP_PORT=1025                                      # Mailhog SMTP (8025 = web UI)
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartCourse <noreply@smartcourse.local>

# ─── Dev seed users (created by migrate in docker-compose) ───────────────────
SEED_DEV_USERS=true
DEV_ADMIN_EMAIL=admin@smartcourse.local
DEV_ADMIN_PASSWORD=SmartCourseAdmin1!
DEV_INSTRUCTOR_EMAIL=instructor@smartcourse.local
DEV_INSTRUCTOR_PASSWORD=SmartCourseInstruct1!
