# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=smartcourse
POSTGRES_PASSWORD=smartcourse
POSTGRES_DB=smartcourse
DATABASE_URL=postgresql+psycopg://smartcourse:smartcourse@localhost:5432/smartcourse

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Temporal (Week 2) ───────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233

# ─── Kafka (Week 3) ──────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# ─── MongoDB (Week 3 — raw event log) ─────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_DB=smartcourse

# ─── Tracing (Week 3 — OpenTelemetry → Jaeger) ────────────────────────────
# empty = disabled (host dev). In docker-compose this is overridden to http://jaeger:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
