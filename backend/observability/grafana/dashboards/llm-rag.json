{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "stat",
      "title": "LLM requests / sec (5m)",
      "description": "Rate of chat completions reaching the LLM (success, error, or cancelled).",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(smartcourse_llm_requests_total[5m]))", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 4 } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total LLM requests",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(smartcourse_llm_requests_total)", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg TTFT (s)",
      "description": "Time-to-first-token — wall-clock silence before the answer starts streaming. This is what the user feels.",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(smartcourse_llm_time_to_first_token_seconds_sum) / clamp_min(sum(smartcourse_llm_time_to_first_token_seconds_count), 1)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 60 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg prompt tokens",
      "description": "Prompt length in tokens (Ollama prompt_eval_count). Longer prompts → longer prefill on CPU.",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(smartcourse_llm_prompt_tokens_sum) / clamp_min(sum(smartcourse_llm_prompt_tokens_count), 1)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Throughput (tok/s)",
      "description": "Output tokens per second during generation (eval phase only).",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(smartcourse_llm_tokens_generated_total[5m])) / clamp_min(sum(rate(smartcourse_llm_eval_seconds_sum[5m])), 0.001)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2 } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Error / cancelled rate (5m)",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "100 * sum(rate(smartcourse_llm_requests_total{outcome!=\"success\"}[5m])) / clamp_min(sum(rate(smartcourse_llm_requests_total[5m])), 0.0001)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },

    {
      "id": 101,
      "type": "row",
      "title": "Timing breakdown (averages)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Avg wall-clock (s)",
      "description": "Full streamed completion time — retrieval done, LLM finished.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (smartcourse_llm_generation_seconds_sum) / clamp_min(sum by (model) (smartcourse_llm_generation_seconds_count), 1)",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 } }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Avg prefill / prompt-eval (s)",
      "description": "Ollama prompt_eval_duration — model reading the RAG context before token 1. Usually the dominant slice on CPU.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (smartcourse_llm_prompt_eval_seconds_sum) / clamp_min(sum by (model) (smartcourse_llm_prompt_eval_seconds_count), 1)",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 120 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Avg token generation (s)",
      "description": "Ollama eval_duration — time spent generating output tokens after prefill.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (smartcourse_llm_eval_seconds_sum) / clamp_min(sum by (model) (smartcourse_llm_eval_seconds_count), 1)",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Prefill vs generation (avg, s)",
      "description": "Side-by-side view of where LLM time goes. If prefill ≫ generation, shrink RAG context.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (smartcourse_llm_prompt_eval_seconds_sum) / clamp_min(sum by (model) (smartcourse_llm_prompt_eval_seconds_count), 1)",
          "refId": "A",
          "legendFormat": "prefill {{model}}"
        },
        {
          "expr": "sum by (model) (smartcourse_llm_eval_seconds_sum) / clamp_min(sum by (model) (smartcourse_llm_eval_seconds_count), 1)",
          "refId": "B",
          "legendFormat": "generation {{model}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 102,
      "type": "row",
